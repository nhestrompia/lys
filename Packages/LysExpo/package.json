{
  "name": "@lys/testkit",
  "version": "0.4.0",
  "description": "Small semantic test contract for Lys and Expo/React Native apps",
  "license": "MIT",
  "homepage": "https://github.com/nhestrompia/lys#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhestrompia/lys.git",
    "directory": "Packages/LysExpo"
  },
  "bugs": "https://github.com/nhestrompia/lys/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "require": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./app.plugin": "./app.plugin.js"
  },
  "files": ["dist", "src", "ios", "app.plugin.js", "expo-module.config.json"],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo": ">=52",
    "expo-modules-core": ">=2",
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run build && node scripts/check.mjs && node scripts/test.mjs",
    "prepack": "npm run check"
  }
}
